<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 官方 OpenAPI 与 Gateway WSS 都走 HTTPS / WSS，必须联网权限。
         注意：Flutter 模板只在 debug / profile 清单里声明了 INTERNET，
         release 清单默认没有 —— 漏掉会导致打包后所有网络请求直接失败。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus 用于监听网络切换后重建长连接。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ 前台服务常驻通知需要运行时权限。
         注意：即使未授权，前台服务仍然成立（进程照样脱离 cached 状态），
         只是通知不显示；因此这里不做「不给权限就不保活」的强绑定。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 前台服务用于维持 WSS 长连接；Android 14 起必须声明服务类型权限。
         两种类型都要声明：API 34+ 用 specialUse（无时长上限），
         API 29~33 用 dataSync 兜底（那时还没有 specialUse）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- 息屏后仍要按时发心跳，必须持有 PARTIAL_WAKE_LOCK。
         前台服务只解决「进程被冻结」，不解决「CPU 停止调度」。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="Lave"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:extractNativeLibs="true">
        <!-- allowBackup 必须关闭：否则系统云备份还原后
             flutter_secure_storage 会抛 InvalidKeyException: Failed to unwrap key，
             用户表现为「凭证突然读不出来」。这是官方插件文档明确列出的坑。 -->

        <!-- extractNativeLibs 必须为 true（与 build.gradle.kts 的
             packaging.jniLibs.useLegacyPackaging 一致）：内置 Python 的启动器
             libpylauncher.so 需要作为**可执行文件**运行，而 Android 10 起
             应用只能执行安装后原生库目录中的文件，该目录仅在解压模式下存在。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 维持 WSS 长连接的前台服务。

             foregroundServiceType 同时声明 dataSync 与 specialUse：
             运行时在 API 34+ 选 specialUse（无时长上限），低版本退回 dataSync。
             两者都必须在此声明，否则 startForeground 会因类型不匹配抛
             MissingForegroundServiceTypeException 或 IllegalArgumentException。

             stopWithTask=false（默认值，显式写出）：用户从最近任务里划掉应用时
             服务继续运行——保活的意义就在于此。 -->
        <service
            android:name=".GatewayKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <!-- specialUse 类型官方要求说明具体用途（Google Play 审核会读这段）。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="维持与腾讯 QQ 机器人开放平台网关的 WebSocket 长连接：需按服务端下发的周期持续发送心跳，进程被系统冻结即断连、机器人掉线。" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
